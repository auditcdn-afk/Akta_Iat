APP_NAME=SIMPAS-IAT
# Di server produksi WAJIB: APP_ENV=production dan APP_DEBUG=false.
# APP_DEBUG=true membuat Laravel mengumpulkan query log + stack trace penuh
# pada setiap request (lambat) dan menampilkan detail internal saat error.
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Isi dengan string acak yang panjang HANYA jika hosting Anda cuma punya FTP
# (tanpa SSH/cron) dan perlu memicu migrate/refresh lewat URL browser —
# lihat App\Http\Controllers\DeployController. Kosongkan kalau tidak dipakai.
DEPLOY_SECRET=
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Driver `file` menghindari satu query DB per request hanya untuk membaca
# session. Ganti ke `database` hanya jika aplikasi dijalankan multi-server.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Masa berlaku token API (menit). 10080 = 7 hari. Kosongkan/hapus untuk tidak pernah kedaluwarsa.
SANCTUM_TOKEN_EXPIRATION=10080

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Sama seperti session: `file` menghemat query DB per request. Pakai
# `database` hanya kalau cache perlu dibagi antar beberapa server.
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
